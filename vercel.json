{
  "version": 2,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/biotech",
      "destination": "/biotech/index.html"
    },
    {
      "source": "/autoparts",
      "destination": "/autoparts/index.html"
    },
    {
      "source": "/instruments",
      "destination": "/instruments/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|png|jpg|jpeg|svg|ico|webp|gif|json|woff2?|ttf|eot|xml|txt|map|webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}