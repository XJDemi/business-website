{
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "." } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/admin/(.*)", "dest": "/admin/index.html" },
    { "src": "/biotech/(.*)", "dest": "/biotech/index.html" },
    { "src": "/autoparts/(.*)", "dest": "/autoparts/index.html" },
    { "src": "/instruments/(.*)", "dest": "/instruments/index.html" },
    { "src": "/i18n/(.*)", "dest": "/i18n/$1" },
    { "src": "/(.*)\\.(js|css|png|jpg|jpeg|svg|ico|webp|gif|json|woff2?|ttf|eot|xml|txt|map|webmanifest)$", "dest": "/$1.$2" },
    { "src": "/about\\.html", "dest": "/about.html" },
    { "src": "/contact\\.html", "dest": "/contact.html" },
    { "src": "/products\\.html", "dest": "/products.html" },
    { "src": "/logo\\.html", "dest": "/logo.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|png|jpg|jpeg|svg|ico|webp|gif|woff2?|ttf|eot|webmanifest)$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/i18n/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
